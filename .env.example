# ─── Core App ────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Auth Providers ──────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ─── Database (Neon: use pooled URL in production) ───
DATABASE_URL=postgresql://gulshan:gulshan@localhost:5432/gulshan_dynasty

# ─── MinIO (local Docker) ────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=community-files

# ─── Cloudflare R2 (production / Vercel) ─────────────
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=community-files

# ─── Email ───────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@gulshandynasty.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Cron (Vercel sends Authorization: Bearer <CRON_SECRET>) ─
CRON_SECRET=

# ─── Bootstrap ───────────────────────────────────────
SETUP_SECRET=
